            },
            {
              "term": "de eindbestemming",
              "meaning": "final destination",
              "forms": "de eindbestemmingen",
              "note": "New focus here: a journey as a movement from one place to another; previously used for travel by train.",
              "id": "16eda50f-2f09-4ce9-b17d-0f3f11c22ff3",
              "example": "Utrecht is mijn eindbestemming."
            },
            {
              "term": "door het park",
              "meaning": "through the park",
              "example": "Sofia is door het park gegaan.",
