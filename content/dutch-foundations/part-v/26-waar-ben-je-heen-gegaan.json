          "styles": {
            "textColor": "blue"
          }
        },
        {
          "text": " naar het centrum ",
          "styles": {
            "textColor": "purple"
          }
        },
        {
          "text": "gegaan",
          "styles": {
            "bold": true
          }
        },
        {
          "text": ".",
          "styles": {}
        }
      ],
      "props": {
        "translation": "We went to the city centre.",
        "note": "The participle stays at the end."
      },
      "id": "8cc426d9-986d-420c-97ca-783c2597dbc3"
    },
    {
      "type": "callout",
      "props": {
        "variant": "important",
        "icon": "star"
      },
      "content": "Keep the same order as row 25: subject + finite zijn + other information + participle. In a yes/no question, finite zijn comes first.",
      "id": "f992870f-73f8-480a-a031-f987ec6e6b49"
    },
    {
      "type": "example",
      "content": [
        {
          "text": "",
          "styles": {}
        },
        {
          "text": "Ben",
          "styles": {
            "bold": true,
            "textColor": "blue"
          }
        },
        {
          "text": " je naar Utrecht ",
          "styles": {}
        },
        {
          "text": "teruggekomen",
          "styles": {
            "bold": true
          }
        },
        {
          "text": "?",
          "styles": {}
        }
      ],
      "props": {
        "translation": "Did you return to Utrecht?",
        "note": "A yes/no question starts with the finite verb ben."
      },
      "id": "c4049b73-a81a-4707-8691-3022a212836d"
    },
    {
      "type": "example",
      "content": [
        {
          "text": "Sofia ",
          "styles": {
            "textColor": "green"
          }
        },
        {
          "text": "is",
          "styles": {
            "textColor": "blue"
          }
        },
        {
