          "styles": {}
        },
        {
          "text": "gegaan",
          "styles": {
            "bold": true
          }
        },
        {
          "text": ".",
          "styles": {}
        }
      ],
      "props": {
        "translation": "Sofia went through the park yesterday.",
        "note": "Gaan can describe going through a place; the example describes Sofia’s Monday walk."
      },
      "id": "67ddcd27-d0fd-4a20-b9a8-8dd8988c9bf3"
    },
    {
      "type": "example",
      "content": [
        {
          "text": "Daan ",
          "styles": {
            "textColor": "green"
          }
        },
        {
          "text": "is",
          "styles": {
            "textColor": "blue"
          }
        },
        {
          "text": " vroeg ",
          "styles": {}
        },
        {
          "text": "vertrokken",
          "styles": {
            "bold": true
          }
        },
        {
          "text": ".",
          "styles": {}
        }
      ],
      "props": {
        "translation": "Daan left early.",
        "note": "Vertrekken is a selected change-of-location verb; learn vertrokken as a whole form."
      },
      "id": "1cef7b29-b81a-4a30-b635-a80c2431ebf1"
    },
    {
      "type": "callout",
      "props": {
        "variant": "warning",
        "icon": "triangle-alert"
      },
      "content": [
        {
          "text": "Put the participle at the end: ",
          "styles": {}
        },
        {
          "text": "*Ik ben gegaan naar huis.",
          "styles": {
            "italic": true,
            "backgroundColor": "gray"
          }
        },
        {
          "text": " → ",
          "styles": {}
        },
        {
          "text": "Ik ben naar huis gegaan.",
          "styles": {
            "bold": true
          }
        },
        {
          "text": "",
          "styles": {}
        }
      ],
      "id": "2814b930-36eb-4761-a6d1-85fac6e520cc"
    },
    {
      "type": "heading",
      "props": {
        "level": 3
      },
      "content": "Destination and location",
      "id": "b997bfbf-dee0-4008-9310-42924c627b3e"
    },
    {
      "type": "paragraph",
      "content": "Use naar for a destination: naar huis, naar het centrum. Use thuis when someone is at home. The forms answer different questions: Waar ga je heen? Naar huis. Waar ben je? Thuis.",
      "id": "27a6c8ac-b598-4b4e-8f61-fa675e238baa"
    },
    {
      "type": "example",
      "content": [
        {
          "text": "Waar ben je heen ",
          "styles": {}
        },
        {
          "text": "gegaan",
          "styles": {
            "bold": true
          }
        },
        {
          "text": "? — Naar huis.",
          "styles": {}
        }
      ],
      "props": {
        "translation": "Where did you go? — Home.",
        "note": "Heen is part of the question chunk; naar names the destination."
      },
      "id": "ca94bdc0-7224-4198-8fad-a2ea91d8d4b1"
    },
    {
      "type": "example",
      "content": [
        {
          "text": "Ik ben onderweg naar huis.",
          "styles": {}
        }
      ],
      "props": {
        "translation": "I am on my way home.",
        "note": "Onderweg describes the journey in progress; this sentence is in the present."
      },
      "id": "d6048d44-8cfe-4703-bf11-156c0fd7e07d"
    },
    {
      "type": "vocabulary",
      "props": {
        "data": {
          "words": [
            {
              "term": "aankomen",
              "meaning": "to arrive",
              "forms": "hij komt aan · kwam aan · aangekomen",
