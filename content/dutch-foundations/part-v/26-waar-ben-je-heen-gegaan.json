          "styles": {}
        }
      ],
      "props": {
        "translation": "Noor stayed at home.",
        "note": "Learn gebleven as a complete participle."
      },
      "id": "cdd37ffe-6773-42b4-87b7-18566c02a4ed"
    },
    {
      "type": "example",
      "content": [
