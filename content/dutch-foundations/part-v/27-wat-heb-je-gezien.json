        "level": 2
      },
      "id": "d82c34cc-9964-42f4-8598-bff4e3acc921"
    },
    {
      "type": "heading",
      "content": "Irregular forms",
      "props": {
        "level": 3
      },
      "id": "4ded91a1-34a5-4a55-a9f6-1254c693d4a3"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Complete each perfect sentence.",
          "items": [
            {
              "prompt": "Ik heb thee … (drinken).",
              "authorsVersion": [
                "gedronken"
              ],
              "note": "Drinken has the irregular participle gedronken."
            },
            {
              "prompt": "Noor heeft de foto … (zien).",
              "authorsVersion": [
                "gezien"
              ],
              "note": "The participle goes at the end: lezen → gelezen."
            },
            {
              "prompt": "We hebben samen … (eten).",
              "authorsVersion": [
                "gegeten"
              ],
              "note": "The participle goes at the end: lezen → gelezen."
            },
            {
              "prompt": "Sofia heeft een brief … (schrijven).",
              "authorsVersion": [
                "geschreven"
              ],
              "note": "The participle of schrijven is geschreven; put it at the end."
            },
            {
              "prompt": "Heb je dat boek … (lezen)?",
              "authorsVersion": [
                "gelezen"
              ],
              "note": "The participle goes at the end: lezen → gelezen."
            },
            {
              "prompt": "Wat heb je gisteren … (doen)?",
              "authorsVersion": [
                "gedaan"
              ],
              "note": "Doen is irregular; its participle is gedaan."
            },
            {
              "prompt": "Ik heb een fijne kerst … (hebben).",
              "authorsVersion": [
                "gehad"
              ],
              "note": "The participle goes at the end: lezen → gelezen."
            }
          ]
        }
      },
      "id": "888d3fd4-1fb7-470a-b2aa-b145a1f96506"
    },
    {
      "type": "heading",
      "content": "Recognize the pattern",
      "props": {
        "level": 3
      },
      "id": "150300ce-5dc2-48e1-a000-e2d58fc44e3b"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Complete the participle.",
          "items": [
            {
              "prompt": "bezoeken → …",
              "authorsVersion": [
                "bezocht"
              ],
              "note": "Inseparable be- takes no ge-."
            },
            {
              "prompt": "vertellen → …",
              "authorsVersion": [
                "verteld"
              ],
              "note": "Inseparable ver- takes no ge-."
            },
            {
              "prompt": "ontdekken → …",
              "authorsVersion": [
                "ontdekt"
              ],
              "note": "Inseparable ont- takes no ge-."
            },
            {
              "prompt": "studeren → …",
              "authorsVersion": [
                "gestudeerd"
              ],
              "note": "An -eren verb uses ge- before the stem."
            },
            {
              "prompt": "opbellen → …",
              "authorsVersion": [
                "opgebeld"
              ],
              "note": "Put ge between op and bellen."
            },
            {
              "prompt": "bekijken → …",
              "authorsVersion": [
                "bekeken"
              ],
              "note": "Be- is inseparable, so there is no ge-. The participle is bekeken."
            },
            {
              "prompt": "Wat is correct: geverteld or verteld?",
              "authorsVersion": [
                "verteld"
              ],
              "note": "Do not add ge- after inseparable ver-."
            }
          ]
        }
      },
      "id": "13397231-b97a-47f3-897f-53ac6ea5402c"
    },
    {
      "type": "heading",
      "content": "Complete the dialogue",
      "props": {
        "level": 3
      },
      "id": "64968ec1-db13-4a5e-97f1-b434d09f6635"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Fill each blank with the correct participle.",
          "items": [
            {
              "prompt": "Noor: Heb je het boek …? (lezen) / Sofia: Ja, ik heb het … .",
              "authorsVersion": [
                "gelezen",
                "gelezen"
              ],
              "note": "The participle goes at the end."
            },
            {
              "prompt": "Sofia: Heb je de paella …? (eten) / Noor: Ja, ik heb ervan … .",
              "authorsVersion": [
                "gegeten",
                "gegeten"
              ],
              "note": "Eten → gegeten."
            },
            {
              "prompt": "Noor: Heb je mijn bericht …? (zien) / Sofia: Ja, ik heb het … .",
              "authorsVersion": [
                "gezien",
                "gezien"
              ],
              "note": "Zien has the irregular participle gezien; put it at the end of each clause."
            },
            {
              "prompt": "Sofia: Heb je je moeder …? (opbellen) / Noor: Ja, ik heb haar … .",
              "authorsVersion": [
                "opgebeld",
                "opgebeld"
              ],
              "note": "Separable prefix op surrounds ge."
            },
            {
              "prompt": "Noor: Wat heb je met kerst …? (doen) / Sofia: Ik heb met mijn moeder … .",
              "authorsVersion": [
                "gedaan",
                "gedaan"
              ],
              "note": "Zien has the irregular participle gezien; put it at the end of each clause."
            },
            {
              "prompt": "Sofia: Heb je het verhaal …? (vertellen) / Noor: Ja, ik heb het … .",
              "authorsVersion": [
                "verteld",
                "verteld"
              ],
              "note": "Ver- is inseparable."
            }
          ]
        }
      },
      "id": "ebe7825e-dd5c-422b-b198-4a0200a71022"
    },
    {
      "type": "heading",
      "content": "Put the participle last",
      "props": {
        "level": 3
      },
      "id": "89c8e383-3148-4368-bc7a-15e8a409bf4b"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Put the chunks in order. Include punctuation.",
          "items": [
            {
              "prompt": "Put in order: heb / ik / de foto’s / gezien",
              "authorsVersion": [
                "Ik heb de foto’s gezien."
              ],
              "note": "The participle goes at the end."
            },
            {
              "prompt": "Put in order: heeft / Sofia / een boek / gelezen",
              "authorsVersion": [
                "Sofia heeft een boek gelezen."
              ],
              "note": "Keep the participle at the end of the statement."
            },
            {
              "prompt": "Put in order: heb / je / de paella / gegeten / ?",
              "authorsVersion": [
                "Heb je de paella gegeten?"
              ],
              "note": "In a yes/no question, the helper comes first."
            },
            {
              "prompt": "Put in order: heeft / Noor / Sofia / opgebeld",
              "authorsVersion": [
                "Noor heeft Sofia opgebeld."
              ],
              "note": "In a yes/no question, put the finite helper first; the participle stays last."
            },
            {
              "prompt": "Put in order: is / in Valencia / Sofia / geweest",
              "authorsVersion": [
                "Sofia is in Valencia geweest."
              ],
              "note": "The participle stays at the end."
            },
            {
              "prompt": "Put in order: met kerst / heeft / Nederlands / Sofia / gestudeerd",
              "authorsVersion": [
                "Met kerst heeft Sofia Nederlands gestudeerd."
              ],
              "note": "A fronted time phrase is followed by the finite verb, then the subject."
            }
          ]
        }
      },
      "id": "9d1b855e-1ecd-474d-9822-1acfa07fad4d"
    },
    {
      "type": "heading",
      "content": "Change to the perfect",
      "props": {
        "level": 3
      },
      "id": "dd97f2d4-570c-4249-a7af-cd7f9cafed5e"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Rewrite using the perfect. Keep the meaning.",
          "items": [
            {
              "prompt": "Sofia ziet de foto. → Sofia …",
              "authorsVersion": [
                "Sofia heeft de foto gezien."
              ],
              "note": "Use the matching present form of hebben and the irregular participle at the end."
            },
            {
              "prompt": "Noor leest het boek. → Noor …",
              "authorsVersion": [
                "Noor heeft het boek gelezen."
              ],
              "note": "Use the matching present form of hebben and the irregular participle at the end."
            },
            {
              "prompt": "Sofia schrijft een brief. → Sofia …",
              "authorsVersion": [
                "Sofia heeft een brief geschreven."
              ],
              "note": "Use the matching present form of hebben and the irregular participle at the end."
            },
            {
              "prompt": "Noor belt Sofia op. → Noor …",
              "authorsVersion": [
                "Noor heeft Sofia opgebeld."
              ],
              "note": "The participle keeps the separable prefix around ge."
            },
            {
              "prompt": "Sofia studeert Nederlands. → Sofia …",
              "authorsVersion": [
                "Sofia heeft Nederlands gestudeerd."
              ],
              "note": "Use the matching present form of hebben and the irregular participle at the end."
            },
            {
              "prompt": "Sofia is in Valencia. → Sofia … geweest.",
              "authorsVersion": [
                "Sofia is in Valencia geweest."
              ],
              "note": "Use the already-taught zijn perfect with geweest."
            }
          ]
        }
      },
      "id": "65bd323c-d1e8-412a-ab29-6f41733635cb"
    },
    {
