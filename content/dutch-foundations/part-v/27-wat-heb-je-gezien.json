            "backgroundColor": "yellow"
          }
        },
        "."
      ],
      "props": {
        "translation": "Noor saw the photos.",
        "note": "The participle of zien is gezien."
      },
      "id": "7425b964-485d-410a-b4e6-1a6e1273df96"
    },
