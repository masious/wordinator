      "id": "95f0ffd7-e3e3-49a8-a35c-a516966b0ef7"
    },
    {
      "type": "vocabulary",
      "props": {
        "data": {
          "words": [
            {
              "term": "bekijken",
              "meaning": "to look at, view",
              "forms": "bekijkt · bekeek · bekeken",
              "example": "Sofia heeft alle foto’s bekeken.",
              "note": "New meaning and perfect form; be- is inseparable, so no ge-.",
              "id": "50222039-94ce-4fe1-8ca1-d7eaf77c3719"
            },
            {
              "term": "opschrijven",
              "meaning": "to write down",
              "forms": "schrijft op · schreef op · opgeschreven",
              "example": "Sofia heeft de naam opgeschreven.",
              "note": "Separable verb: ge comes between op and schrijven.",
              "id": "07313fe1-4714-4c96-8a7c-923a669c13f9"
            }
          ]
        }
      },
      "id": "17abb297-9a25-4954-897b-92f525e1d967"
    },
    {
      "type": "divider",
      "id": "50876f86-6eee-45cb-8cc4-67d96c4a3abc"
    },
    {
      "type": "heading",
