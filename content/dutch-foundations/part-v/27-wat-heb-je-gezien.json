    {
      "type": "numberedListItem",
      "content": "Learn common irregular participles as complete forms: gedaan, gezien, gegeten, gedronken, gelezen, geschreven, gehad, geweest.",
      "id": "692e8f26-693c-4cd1-982e-ebafaee31994"
    },
    {
      "type": "numberedListItem",
      "content": "In inseparable be-, ver- and ont- verbs, do not add ge-.",
      "id": "74c3d84b-fe03-4348-8a7a-564f256efa8a"
    },
    {
      "type": "numberedListItem",
      "content": "With verbs ending in -eren, use ge- before the stem; with separable verbs, place ge between prefix and verb.",
