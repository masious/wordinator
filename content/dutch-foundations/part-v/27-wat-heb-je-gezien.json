    {
      "type": "callout",
      "content": "The auxiliary is still finite: ik heb / zij heeft; ik ben / zij is. Put the participle at the end, even when the sentence begins with a time or place phrase.",
      "props": {
        "variant": "important",
        "icon": "star"
      },
      "id": "eaf144a2-099c-4545-b243-e73a41582d45"
    },
    {
      "type": "callout",
      "content": [
        {
          "text": "*Ik heb gezien de foto’s.",
          "styles": {
