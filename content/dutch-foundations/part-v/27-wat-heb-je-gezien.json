          "text": "gegeten",
          "styles": {
            "bold": true,
            "backgroundColor": "yellow"
          }
        },
        "."
      ],
      "props": {
        "translation": "I ate the paella.",
        "note": "Eten uses hebben here; the participle is gegeten."
      },
      "id": "068b6583-c327-4216-8ad9-00a648e4c186"
    },
