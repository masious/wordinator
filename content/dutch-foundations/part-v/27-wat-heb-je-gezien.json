    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Translate each sentence into natural Dutch.",
          "items": [
            {
              "prompt": "I drank water.",
              "authorsVersion": [
                "Ik heb water gedronken."
              ],
              "note": "Use the irregular participle at the end with the present form of hebben."
            },
            {
              "prompt": "Noor saw the photos.",
              "authorsVersion": [
                "Noor heeft de foto’s gezien."
              ],
              "note": "Use the irregular participle at the end with the present form of hebben."
            },
            {
              "prompt": "Sofia read a book.",
              "authorsVersion": [
                "Sofia heeft een boek gelezen."
              ],
              "note": "Use the irregular participle at the end with the present form of hebben."
            },
            {
              "prompt": "Did you eat the paella?",
              "authorsVersion": [
                "Heb je de paella gegeten?"
              ],
              "note": "The helper comes first in a yes/no question."
            },
            {
              "prompt": "Sofia studied Dutch at Christmas.",
              "authorsVersion": [
                "Sofia heeft met kerst Nederlands gestudeerd."
              ],
              "note": "Use the irregular participle at the end with the present form of hebben."
            },
            {
              "prompt": "Noor called Sofia.",
              "authorsVersion": [
                "Noor heeft Sofia opgebeld."
              ],
              "note": "Opbellen is separable; its participle is opgebeld."
            }
          ]
        }
