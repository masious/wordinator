    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Fill each blank with the correct past form.",
          "items": [
            {
              "prompt": "Noor: Waar … je vroeger? (wonen) / Sofia: Ik … in Valencia. (wonen)",
              "authorsVersion": [
                "woonde",
                "woonde"
              ],
              "note": "jij has woonde; ik has woonde."
            },
            {
              "prompt": "Sofia: … je een step? (hebben) / Noor: Ja, ik … een rode step. (hebben)",
              "authorsVersion": [
                "Had",
                "had"
              ],
              "note": "In a yes/no question, the verb comes first."
            },
            {
              "prompt": "Noor: Wat … je na school? (doen) / Sofia: Ik … vaak buiten. (spelen)",
              "authorsVersion": [
                "deed",
                "speelde"
              ],
              "note": "doen has the fixed form deed; spelen is regular."
            },
            {
              "prompt": "Sofia: … jullie naar school? (fietsen) / Noor: Ja, wij … samen. (fietsen)",
              "authorsVersion": [
                "Fietsten",
                "fietsten"
              ],
              "note": "Plural subject: fietsten."
            },
            {
              "prompt": "Noor: … je school groot? (zijn) / Sofia: Nee, mijn school … klein. (zijn)",
              "authorsVersion": [
                "Was",
                "was"
              ],
              "note": "Singular past form of zijn."
            },
            {
              "prompt": "Sofia: … jullie vaak huiswerk? (hebben) / Noor: Ja, wij … huiswerk. (hebben)",
              "authorsVersion": [
                "Hadden",
                "hadden"
              ],
              "note": "Plural subject takes hadden."
            }
          ]
        }
      },
      "id": "65fd0740-cdc9-4a1d-af7e-faa2fc48be17"
