    {
      "type": "heading",
      "content": "Regular past endings",
      "props": {
        "level": 3
      },
      "id": "df29a96e-5e6b-4185-ab8b-f7e58ac5774f"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Fill in the past form of the verb in brackets.",
          "items": [
            {
              "prompt": "Ik … in Valencia. (wonen)",
              "authorsVersion": [
                "woonde"
              ],
              "note": "wonen: stem woon + -de."
            },
            {
              "prompt": "Wij … in Groningen. (wonen)",
              "authorsVersion": [
                "woonden"
              ],
              "note": "Plural wij takes -den."
            },
            {
              "prompt": "Noor … naar school. (fietsen)",
              "authorsVersion": [
                "fietste"
              ],
              "note": "The stem ends in s, so use -te."
            },
            {
              "prompt": "De kinderen … buiten. (spelen)",
              "authorsVersion": [
                "speelden"
              ],
              "note": "Plural subject takes -den."
            },
            {
              "prompt": "Ik … vaak. (werken)",
              "authorsVersion": [
                "werkte"
              ],
              "note": "The stem ends in k, so use -te."
            },
            {
              "prompt": "Jullie … Nederlands. (leren)",
              "authorsVersion": [
                "leerden"
              ],
              "note": "The stem ends in r, so use -den."
            },
            {
              "prompt": "Ik … vaak in het park. (wandelen)",
              "authorsVersion": [
                "wandelde"
              ],
              "note": "The stem ends in l, so use -de."
            }
          ]
        }
      },
      "id": "e995a0a6-ed88-40f2-9fb3-e8bfda5889a8"
    },
    {
