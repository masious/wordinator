    },
    {
      "type": "heading",
      "props": {
        "level": 2
      },
      "content": "Story: role-play at the desk",
      "id": "b58ff1f4-f434-40af-985f-431bdf2c3a86"
    },
    {
      "type": "dialogue",
      "props": {
        "turns": [
          {
            "speaker": "Marieke",
            "text": "Nu oefenen jullie bij een gemeentelijke balie."
          },
          {
            "speaker": "Piotr",
            "text": "Goedemiddag. Kunt u mij helpen?"
          },
          {
            "speaker": "Sofia",
            "text": "Natuurlijk. Wat zoekt u?"
          },
          {
            "speaker": "Piotr",
            "text": "Ik zoek een formulier."
          },
          {
            "speaker": "Sofia",
            "text": "Welk formulier zoekt u?"
          },
          {
            "speaker": "Piotr",
            "text": "Dat weet ik niet. Het gaat om een adres."
          },
          {
            "speaker": "Sofia",
            "text": "Zou u de naam kunnen spellen?"
          },
          {
            "speaker": "Piotr",
            "text": "Ja, natuurlijk. Kunt u dat herhalen?"
          },
          {
            "speaker": "Sofia",
            "text": "De naam van het formulier, alstublieft."
          },
          {
            "speaker": "Piotr",
            "text": "Dank u wel."
          },
          {
            "speaker": "Marieke",
            "text": "Goed gedaan. Dit blijft een rollenspel."
          }
        ]
      },
      "id": "a36426f8-8fd9-474a-a288-dfc204fb4ed9"
    },
    {
      "type": "vocabulary",
