    },
    {
      "type": "example",
      "props": {
        "translation": "Could you repeat that, please?",
        "note": "Recycles zou + infinitive from Part VI."
      },
      "content": [
        {
          "text": "Zou u dat kunnen herhalen, alstublieft?",
          "styles": {
            "bold": true,
            "textColor": "blue"
          }
        }
      ],
      "id": "db6c7aaa-1cfc-46bf-84c2-76b565394423"
    },
    {
