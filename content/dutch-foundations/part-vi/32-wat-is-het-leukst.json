    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Rewrite as instructed. Keep the meaning.",
          "items": [
            {
              "prompt": "Make a superlative: Utrecht is rustig. (quietest of these cities)",
              "authorsVersion": [
                "Utrecht is het rustigst van deze steden."
              ],
              "note": "Use het + -st and name the group."
            },
            {
              "prompt": "Make a comparative: Valencia is warm. Utrecht is warm. (compare Valencia with Utrecht)",
              "authorsVersion": [
                "Valencia is warmer dan Utrecht."
              ],
              "note": "Comparative + dan."
            },
            {
              "prompt": "Make a superlative before a noun: Dit café is comfortabel. (most comfortable café)",
              "authorsVersion": [
                "Dit is het comfortabelste café."
              ],
              "note": "Before het café, use het + -ste."
            },
            {
              "prompt": "Change to a comparison of equality: De straat is breed. De andere straat is breed.",
              "authorsVersion": [
                "De straat is even breed als de andere straat."
              ],
              "note": "Recycles even … als."
            },
            {
              "prompt": "Correct the mistake: Utrecht is het meest klein.",
              "authorsVersion": [
                "Utrecht is het kleinst."
              ],
              "note": "For a regular one-syllable adjective, use -st, not meest + base adjective."
            },
            {
              "prompt": "Correct the mistake: De grootst stad is Valencia.",
              "authorsVersion": [
                "De grootste stad is Valencia."
              ],
              "note": "Before a noun, use -ste with adjective inflection."
            }
          ]
        }
      },
      "id": "dd6b162b-4452-413a-9e4d-939c4ecf7e3a"
    },
