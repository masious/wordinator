      "props": {
        "data": {
          "instruction": "Complete each sentence with the correct form.",
          "items": [
            {
              "prompt": "Utrecht is … dan Valencia. (klein)",
              "authorsVersion": [
                "kleiner"
              ],
              "note": "Comparative + dan."
            },
            {
              "prompt": "Welke straat is …, deze of die? (breed)",
              "authorsVersion": [
                "breder"
              ],
              "note": "Comparative of breed is breder."
            },
            {
              "prompt": "Van de drie, welke stad is het …? (warm)",
              "authorsVersion": [
                "warmst"
              ],
              "note": "With zijn: het + -st."
            },
            {
              "prompt": "Dit is … gerecht van de drie. (goed)",
