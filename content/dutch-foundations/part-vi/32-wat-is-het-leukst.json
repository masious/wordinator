    {
      "type": "numberedListItem",
      "content": "Comparative: adjective + -er + dan; equality: even/net zo/niet zo … als.",
      "id": "c3988e94-52bb-49a1-b905-be11b8ace1f7"
    },
    {
      "type": "numberedListItem",
      "content": "As a predicate or adverb, use het + -st: het rustigst.",
      "id": "b031c164-fe6e-48bd-a56b-2586b0d8dd80"
    },
    {
      "type": "numberedListItem",
      "content": "Before a noun, use de/het + -ste + noun: de rustigste straat, het rustigste café.",
      "id": "2f408f7e-2f91-46e8-9aa9-00459582b2af"
    },
    {
      "type": "numberedListItem",
      "content": "Irregular: goed → beter → best(e); veel → meer → meest(e).",
      "id": "3d9176cd-9439-49c2-a401-ff98e35b999b"
    },
    {
      "type": "numberedListItem",
      "content": "Recycled preference: het liefst means “prefer/like best”.",
      "id": "b1b48ece-9441-4ddd-b9b8-6fa33664d5ad"
    }
  ],
