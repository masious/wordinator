    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Put the chunks in order.",
          "items": [
            {
              "prompt": "Put in order: dan / Valencia / warmer / is / Utrecht",
              "authorsVersion": [
                "Utrecht is warmer dan Valencia."
              ],
              "note": "V2: is follows the subject; dan follows the comparative."
            },
            {
              "prompt": "Put in order: het / Utrecht / rustigst / is",
              "authorsVersion": [
                "Utrecht is het rustigst."
              ],
              "note": "Use het + superlative."
            },
            {
              "prompt": "Put in order: straat / is / de / smalste / dit",
              "authorsVersion": [
                "Dit is de smalste straat."
              ],
              "note": "Use de + -ste before a de-word noun."
            },
            {
              "prompt": "Put in order: beste / dit / gerecht / het / is",
              "authorsVersion": [
                "Dit is het beste gerecht."
              ],
              "note": "goed → best; before het gerecht, use beste."
            },
            {
              "prompt": "Put in order: als / deze / net / straat / zo / is / breed / die",
              "authorsVersion": [
                "Deze straat is net zo breed als die."
              ],
              "note": "Recycles equality: net zo … als."
            },
            {
              "prompt": "Put in order: het / vind / zwemmen / leukst / ik",
              "authorsVersion": [
                "Ik vind zwemmen het leukst."
              ],
              "note": "The superlative phrase follows the activity."
            }
          ]
        }
      },
      "id": "f3049f71-250e-48ce-ad70-dd2cc2fdeda3"
    },
    {
