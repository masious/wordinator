                "Mag ik vrij nemen?"
              ],
              "note": "A polite request for permission."
            },
            {
              "prompt": "Sofia can swim well.",
              "authorsVersion": [
                "Sofia kan goed zwemmen."
              ],
              "note": "Ability: kunnen + infinitive."
            },
            {
              "prompt": "You are not allowed to run here.",
              "authorsVersion": [
                "Je mag hier niet rennen."
              ],
              "note": "Mogen niet means prohibited."
            },
            {
              "prompt": "You have to request it in the system.",
              "authorsVersion": [
                "Je moet het in het systeem aanvragen."
              ],
              "note": "Moeten + infinitive at the end."
            },
            {
              "prompt": "Can I work from home on Friday? (possibility)",
              "authorsVersion": [
                "Kan ik op vrijdag thuiswerken?"
              ],
              "note": "Use kan for possibility; also fine: Kan ik vrijdag thuiswerken?"
            },
            {
              "prompt": "That is not possible.",
              "authorsVersion": [
                "Dat kan niet."
              ],
              "note": "The modal can stand alone."
            },
            {
              "prompt": "You must shower first.",
              "authorsVersion": [
                "Je moet eerst douchen."
              ],
              "note": "An obligation."
            }
          ]
        }
      },
      "id": "d46f0664-07d1-4547-a0a9-342a779c87b9"
