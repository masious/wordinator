    {
      "type": "heading",
      "props": {
        "level": 3
      },
      "content": "Complete the office conversation",
      "id": "dcdb38ae-3bb4-4d75-8e72-644d142f04e2"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Complete Sofia and Karin's conversation. Fill each blank with one word.",
          "items": [
            {
              "prompt": "Sofia: … ik vrij nemen van 21 tot en met 31 december? / Karin: Dat … .",
              "authorsVersion": [
                "Mag",
                "mag"
              ],
              "note": "Ask permission with mogen; the short answer repeats mag."
            },
            {
              "prompt": "Sofia: … ik vrijdag thuiswerken? / Karin: Ja, dat … .",
              "authorsVersion": [
                "Kan",
                "kan"
              ],
              "note": "Ask about possibility; dat kan = it is possible."
            },
            {
              "prompt": "Karin: Je … het wel in het systeem aanvragen.",
              "authorsVersion": [
                "moet"
              ],
              "note": "A requirement."
            },
            {
              "prompt": "Sofia: … ik acht dagen aanvragen? / Karin: Ja, dat … .",
              "authorsVersion": [
                "Moet",
                "moet"
              ],
              "note": "The question is whether the request is required; Karin confirms it."
            },
            {
              "prompt": "Sofia: … ik het meteen aanvragen? (possibility) / Karin: Ja, dat … .",
              "authorsVersion": [
                "Kan",
                "kan"
              ],
              "note": "This asks if it is possible now."
            },
            {
              "prompt": "Sofia: Mag ik op vrijdag thuiswerken? / Karin: Ja, dat … .",
              "authorsVersion": [
                "mag"
              ],
              "note": "Permission; mogen can stand alone."
            }
          ]
        }
      },
      "id": "6ac9c6b8-4217-45cb-b294-5cd4d6f79e90"
    },
    {
      "type": "heading",
      "props": {
        "level": 3
      },
      "content": "Put the words in order",
      "id": "2194c1cd-7575-4add-aedb-7a6e2001495a"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Put the words in order. Write the full sentence.",
          "items": [
            {
              "prompt": "Put in order: ik / mag / vrij nemen / ?",
              "authorsVersion": [
                "Mag ik vrij nemen?"
              ],
              "note": "Yes/no question: modal first, subject next, infinitive at the end."
            },
            {
              "prompt": "Put in order: aanvragen / moet / Sofia / het / in het systeem",
              "authorsVersion": [
                "Sofia moet het in het systeem aanvragen."
              ],
              "note": "The separable infinitive stays together at the end."
            },
            {
              "prompt": "Put in order: op vrijdag / thuiswerken / je / kunt",
              "authorsVersion": [
                "Op vrijdag kun je thuiswerken."
              ],
              "note": "After a fronted time phrase, the finite verb comes before the subject."
            },
            {
              "prompt": "Put in order: hier / je / niet / mag / rennen",
              "authorsVersion": [
                "Hier mag je niet rennen."
              ],
              "note": "Fronted place, then modal, subject, niet, infinitive."
            },
            {
              "prompt": "Put in order: douchen / eerst / moeten / jullie",
              "authorsVersion": [
                "Jullie moeten eerst douchen."
              ],
              "note": "Subject, modal, time word, infinitive."
            },
            {
              "prompt": "Put in order: kan / dat / niet",
              "authorsVersion": [
                "Dat kan niet."
              ],
              "note": "The modal stands alone; the action is understood."
            },
            {
              "prompt": "Put in order: naar binnen / mag / ik / ?",
              "authorsVersion": [
                "Mag ik naar binnen?"
              ],
              "note": "Mogen can stand alone before a direction."
            }
          ]
        }
      },
      "id": "114c7d6d-c338-4b55-b67e-4dda06dec370"
    },
    {
      "type": "heading",
      "props": {
        "level": 3
      },
      "content": "Turn signs into full rules",
      "id": "9d183455-fb8d-405b-bbce-e18a2dd5506a"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Turn each short sign into a sentence with mogen (permission) or moeten (obligation). Then rewrite the possibility questions as permission questions where asked.",
          "items": [
            {
              "prompt": "Niet rennen. (you are not allowed)",
              "authorsVersion": [
                "Je mag niet rennen."
              ],
              "note": "For prohibition use mogen niet, not moeten niet."
            },
            {
              "prompt": "Eerst douchen. (you have to)",
              "authorsVersion": [
                "Je moet eerst douchen."
              ],
              "note": "A requirement uses moeten."
            },
            {
              "prompt": "Niet fietsen. (you are not allowed)",
              "authorsVersion": [
                "Je mag niet fietsen."
              ],
              "note": "A prohibition uses mogen niet."
            },
            {
              "prompt": "Niet zwemmen. (you are not allowed)",
              "authorsVersion": [
                "Je mag niet zwemmen."
              ],
              "note": "Use mogen for permission; Ik mag niet zwemmen does not mean I cannot swim."
            },
            {
              "prompt": "Is it possible for me to take leave? Rewrite as a polite permission request.",
              "authorsVersion": [
                "Mag ik vrij nemen?"
              ],
              "note": "At work, Mag ik…? asks permission politely."
            },
            {
              "prompt": "Is it possible for me to work at home on Friday? Keep the possibility meaning.",
              "authorsVersion": [
                "Kan ik op vrijdag thuiswerken?"
              ],
              "note": "Kan ik…? asks about possibility."
            },
            {
              "prompt": "Douchen eerst. (you have to)",
              "authorsVersion": [
                "Je moet eerst douchen."
              ],
              "note": "Natural sign: Eerst douchen. Full rule: Je moet eerst douchen."
            }
          ]
        }
      },
      "id": "ab329709-2099-4e66-9cff-f5e6775bc330"
    },
    {
      "type": "heading",
      "props": {
        "level": 3
      },
      "content": "Translate into Dutch",
      "id": "1193b550-da5f-4906-9ca6-7a4ee07bc9b1"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Translate into Dutch.",
          "items": [
