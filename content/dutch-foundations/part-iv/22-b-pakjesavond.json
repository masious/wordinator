            {
              "prompt": "Change to aan het: Daan zit een pakje uit te pakken.",
              "authorsVersion": [
                "Daan is een pakje aan het uitpakken."
              ],
              "note": "Activity focus; separable infinitive remains together."
            },
            {
              "prompt": "Make negative: Sofia zit te schrijven.",
              "authorsVersion": [
                "Sofia zit niet te schrijven."
              ],
              "note": "Negate before the te-infinitive."
