    {
      "type": "dialogue",
      "props": {
        "turns": [
          {
            "speaker": "Lotte",
            "text": "Wat zijn ze aan het doen in de woonkamer?"
          },
          {
            "speaker": "Sofia",
            "text": "Noor zit te lachen. Fleur staat te dansen!"
          },
          {
            "speaker": "Lotte",
            "text": "En Daan?"
          },
          {
            "speaker": "Sofia",
            "text": "Hij zit zijn gedicht voor te lezen."
          },
          {
            "speaker": "Lotte",
            "text": "En wij?"
          },
          {
            "speaker": "Sofia",
            "text": "We zijn thee aan het maken."
          },
          {
            "speaker": "Lotte",
            "text": "Wat gezellig!"
          },
          {
            "speaker": "Sofia",
            "text": "Ik ben bezig met mijn berichtje voor de les."
          }
        ]
      },
      "id": "d4c4f66b-5233-455f-ba20-078df2219ba3"
