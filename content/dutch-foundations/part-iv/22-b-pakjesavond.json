    {
      "type": "numberedListItem",
      "content": "Use zijn + aan het + infinitive for an activity in progress; niet comes before aan het.",
      "id": "b1fec983-5e50-4286-88ba-900fdd6aa33e"
    },
    {
      "type": "numberedListItem",
      "content": "Use zitten, staan, liggen or lopen + … + te when position or movement matters. Split a separable infinitive around te.",
      "id": "c34b53d4-23ce-4479-b8e6-946d2dc13ed1"
    },
    {
      "type": "numberedListItem",
      "content": "Use bezig zijn met + noun. For plans, use gaan + infinitive.",
