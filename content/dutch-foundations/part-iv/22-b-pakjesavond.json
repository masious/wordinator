              "prompt": "Make negative: Ik ben aan het raden.",
              "authorsVersion": [
                "Ik ben niet aan het raden."
              ],
              "note": "niet before aan het."
            },
            {
              "prompt": "Change to bezig met: Sofia maakt thee. (bezig)",
              "authorsVersion": [
                "Sofia is bezig met thee."
              ],
              "note": "Use a noun after met."
