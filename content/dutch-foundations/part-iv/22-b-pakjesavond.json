    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Fill the gaps with suitable words.",
          "items": [
            {
              "prompt": "Noor: Wie is er aan het …? / Daan: Ik zit het gedicht … te lezen.",
              "authorsVersion": [
                "voorlezen",
                "voor"
              ],
              "note": "Separable voorlezen splits around te."
            },
            {
              "prompt": "Fleur: Ben je aan het raden? / Sofia: Nee, ik ben … aan het raden.",
              "authorsVersion": [
                "niet"
              ],
              "note": "Put niet before aan het."
            },
            {
              "prompt": "Lotte: Wat zijn ze aan het doen? / Sofia: Fleur … te dansen.",
              "authorsVersion": [
                "staat"
              ],
              "note": "Fleur is standing while dancing."
            },
            {
              "prompt": "Noor: Waar ben je mee bezig? / Sofia: Ik ben bezig … mijn berichtje.",
              "authorsVersion": [
                "met"
              ],
              "note": "The fixed pattern is bezig zijn met + noun."
            },
            {
              "prompt": "Daan: Van wie is dit pakje? / Noor: Het is … jou.",
              "authorsVersion": [
                "voor"
              ],
              "note": "voor jou = for you."
            },
            {
              "prompt": "Sofia: Wat grappig! / Daan: Ik zit mijn gedicht … te lezen.",
              "authorsVersion": [
                "voor"
              ],
              "note": "The prefix comes before te."
            }
          ]
        }
