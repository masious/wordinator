              "prompt": "Put in order: bezig / met / Sofia / thee / is",
              "authorsVersion": [
                "Sofia is bezig met thee."
              ],
              "note": "bezig zijn met + noun."
            },
            {
              "prompt": "Put in order: zo / gaan / we / uitpakken",
              "authorsVersion": [
                "We gaan zo uitpakken."
              ],
              "note": "Plan: gaan + bare infinitive."
            },
            {
              "prompt": "Put in order: te / zit / het pakje / Daan / uitpakken",
              "authorsVersion": [
