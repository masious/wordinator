    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Put the words in the correct order. Write the full sentence.",
          "items": [
            {
              "prompt": "Put in order: hard / het / waait",
              "authorsVersion": [
                "Het waait hard."
              ]
            },
            {
              "prompt": "Put in order: snel / Daan / loopt",
              "authorsVersion": [
                "Daan loopt snel."
              ]
            },
            {
              "prompt": "Put in order: Sofia / langzaam / loopt",
              "authorsVersion": [
                "Sofia loopt langzaam."
              ]
            },
            {
              "prompt": "Put in order: een / dag / heel / koude / het is",
              "authorsVersion": [
                "Het is een heel koude dag."
              ]
            },
            {
              "prompt": "Put in order: erg / druk / het is / hier",
              "authorsVersion": [
                "Het is hier erg druk."
              ],
              "note": "Also fine: Het is erg druk hier."
            },
            {
              "prompt": "Put in order: nat / best / is / het",
              "authorsVersion": [
                "Het is best nat."
              ]
            },
            {
              "prompt": "Put in order: warm / lekker / is / het / hier",
              "authorsVersion": [
                "Het is hier lekker warm."
              ],
              "note": "Also fine: Het is lekker warm hier."
            }
          ]
        }
