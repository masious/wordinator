      "content": "Practice",
      "id": "9da8d1fb-6566-4f8c-abab-cbf2229b7fa7"
    },
    {
      "type": "heading",
      "props": {
        "level": 3
      },
      "content": "Fill in the right form",
      "id": "10402bd8-5789-439f-8baf-ac51a746de61"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Fill in the correct form: with -e, or without. The base form is in brackets.",
          "items": [
            {
              "prompt": "Het is een … dag. (koud)",
              "authorsVersion": [
                "koude"
              ],
              "note": "dag is a de-word, so een + adjective → -e."
            },
            {
              "prompt": "De dag is … . (koud)",
              "authorsVersion": [
                "koud"
              ],
              "note": "After is there is no -e."
            },
            {
              "prompt": "Daan loopt … naar de zee. (snel)",
              "authorsVersion": [
                "snel"
              ],
              "note": "Adverb: never an ending."
            },
            {
              "prompt": "Hij heeft een … fiets. (snel)",
              "authorsVersion": [
                "snelle"
              ],
              "note": "fiets is a de-word, so -e after een."
            },
            {
              "prompt": "Het waait … vandaag. (hard)",
              "authorsVersion": [
                "hard"
              ],
              "note": "Adverb: base form."
            },
            {
              "prompt": "Het is een … wind. (hard)",
              "authorsVersion": [
                "harde"
              ],
              "note": "wind is a de-word, so -e after een."
            },
            {
              "prompt": "Sofia loopt … . (langzaam)",
              "authorsVersion": [
                "langzaam"
              ],
              "note": "Adverb: there is no form langzame as an adverb."
            },
            {
              "prompt": "Het is een … wandeling. (langzaam)",
              "authorsVersion": [
                "langzame"
              ],
              "note": "wandeling is a de-word, so -e before the noun."
            },
            {
              "prompt": "Het weer wordt … . (zacht)",
              "authorsVersion": [
                "zacht"
              ],
              "note": "After wordt there is no -e; zacht weer = mild weather."
            }
          ]
        }
      },
      "id": "7f2f2276-8770-4c6b-bd62-9143b83c6c5f"
    },
    {
      "type": "heading",
      "props": {
        "level": 3
      },
      "content": "Beach conversation",
      "id": "c6a23ed4-c324-4bc0-bb46-f5524d52aafb"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Complete the beach conversation. One word per blank.",
          "items": [
            {
              "prompt": "Daan: Jij loopt … , Sofia! / Sofia: En jij loopt altijd … !",
              "authorsVersion": [
                "langzaam",
                "snel"
              ],
              "note": "Both are adverbs: never -e."
            },
            {
              "prompt": "Noor: De zee is … vandaag. / Daan: En de zon … ook!",
              "authorsVersion": [
                "kalm",
                "schijnt"
              ],
              "note": "schijnen is recycled from 17-a."
            },
            {
              "prompt": "Sofia: Het waait hier … ! / Noor: Ja, het waait hier altijd … hard.",
              "authorsVersion": [
                "hard",
                "heel"
              ],
              "note": "heel hard = very hard; heel itself never changes."
            },
            {
              "prompt": "Daan: Het is hier … druk! / Sofia: Ja, het is hier ook … druk.",
              "authorsVersion": [
                "erg",
                "te"
              ],
              "note": "erg = very; te = too (recycle 12-b)."
            },
            {
              "prompt": "Noor: Kijk, een bui! Snel, we … hier! / Sofia: Ja, ik ben … nat!",
              "authorsVersion": [
                "schuilen",
                "best"
              ],
              "note": "schuilen: wij-form is the same as the infinitive. best = quite."
            }
          ]
        }
      },
      "id": "b30e9a3c-3adb-45ef-beed-6ab59d74804e"
    },
    {
      "type": "heading",
