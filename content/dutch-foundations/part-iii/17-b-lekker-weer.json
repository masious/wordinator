      "id": "0b316c36-a2d6-438e-99af-d95f4e32fdbb"
    },
    {
      "type": "heading",
      "props": {
        "level": 3
      },
      "content": "Transformation",
      "id": "33432b9d-2a32-4e3b-998c-767354ae4aa4"
    },
    {
      "type": "practice",
      "props": {
        "data": {
          "instruction": "Rewrite the sentence following the instruction in brackets.",
          "items": [
            {
              "prompt": "De wind is hard. (use waaien)",
              "authorsVersion": [
                "Het waait hard."
              ]
            },
            {
              "prompt": "De regen is hard. (use regenen)",
              "authorsVersion": [
                "Het regent hard."
              ]
            },
            {
              "prompt": "De dag is koud. (rewrite with een … dag)",
              "authorsVersion": [
                "Het is een koude dag."
              ]
            },
            {
              "prompt": "De wind is zacht. (rewrite with een … wind)",
              "authorsVersion": [
                "Het is een zachte wind."
              ]
            },
            {
              "prompt": "Sofia loopt. Ze is langzaam. (combine into one sentence)",
              "authorsVersion": [
                "Sofia loopt langzaam."
              ]
            },
            {
              "prompt": "Het is koud. (add heel)",
              "authorsVersion": [
                "Het is heel koud."
              ]
            },
            {
              "prompt": "Het is druk. (add erg)",
              "authorsVersion": [
                "Het is erg druk."
              ]
