      "content": [
        {
          "type": "text",
          "text": "Er is",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": " en ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "er zijn\n",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": "purpose: Introduce existence before teaching precise location.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "9eca63e8-df48-40ad-8e75-9865a194ad81",
      "type": "paragraph",
      "props": {
        "textColor": "default",
        "backgroundColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Use 'er is' for one thing and 'er zijn' for more than one thing when saying that something exists or is present. Questions use 'is er' and 'zijn er'.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
