{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "w-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordinator",
      "database_id": "121db9bb-accd-41d3-a242-c49029170802",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "wordinator-media"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "PUBLIC_MEDIA_BASE_URL": "https://taalk-images.masious.ir/"
  },
  "observability": {
	"logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    },
    "enabled": true,
	"invocation_logs": true,
	"persist": true
  }
}
