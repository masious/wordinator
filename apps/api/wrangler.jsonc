{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "w-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordinator",
      "database_id": "121db9bb-accd-41d3-a242-c49029170802",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "wordinator-media"
    }
  ],
  "vars": {
    "PUBLIC_MEDIA_BASE_URL": "https://7ae6c114ff33d7282df4b8449c6ab7cf.r2.cloudflarestorage.com/wordinator-media"
  },
  "observability": {
	"logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    },
    "enabled": true,
	"invocation_logs": true,
	"persist": true
  }
}
