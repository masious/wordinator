{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "w-web",
  "compatibility_date": "2025-09-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "WORDINATOR_API_ORIGIN": "https://w-api.choobshoor.workers.dev/"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
